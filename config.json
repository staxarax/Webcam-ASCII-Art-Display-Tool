{
    // -------------------------------------------------------
    // Webcam ASCII Art Display Tool - configuration file -設定ファイル
    // JSONC形式: // コメントが書けます
    // Priority: Command line arguments > This configuration file > Default value 優先順位: コマンドライン引数 > この設定ファイル > デフォルト値 
    // -------------------------------------------------------

    // カメラデバイス番号 (0=内蔵カメラ, 1=外付けカメラ 等)
    "device": 4,

    // ASCIIアートの横幅（文字数）
    "width": 200,

    // true にすると白黒反転
    "invert": true,

    // フレームレート上限
    "fps": 30.0,

    // ASCII文字セット（左が暗い文字、右が明るい文字）
    "ascii_chars": "@%#W$9876543210?!abc;:+=-,. ",

    // -------------------------------------------------------
    // 表示色
    // プリセット名: white / green / cyan / yellow / red / blue / magenta
    // RGB直接指定: "255,100,0" のようにカンマ区切りで指定
    // -------------------------------------------------------

    // 通常の表示色
    "color": "cyan",

    // 差分ハイライト色（動きがあった部分の色）
    "diff_color": "green",

    // -------------------------------------------------------
    // 差分・エッジ検出
    // -------------------------------------------------------

    // 差分閾値: エッジ画像ベース（変化した輪郭のみハイライト）
    // 下げると敏感になる（例: 128 で中程度の変化も拾う）
    "diff_threshold": 80,

    // Cannyエッジ検出の閾値（低いほど多くの輪郭を検出）
    "canny_low": 50,
    "canny_high": 150,

    // -------------------------------------------------------
    // オプション機能（true / false で切り替え）
    // -------------------------------------------------------

    // フレームスキップ: 処理が重いときに古いフレームを捨てて最新を表示
    "skip_frames": false

}
